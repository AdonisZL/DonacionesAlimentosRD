# Ejemplo de configuración / 配置示例
# Copia este archivo como ".env" y coloca tus valores reales. / 复制为 ".env" 并填入你的真实值。

# Base de datos PostgreSQL / 数据库
BD_HOST=localhost
BD_PUERTO=5432
BD_NOMBRE=donaciones_alimentos
BD_USUARIO=postgres
BD_CONTRASENA=tu_contrasena_de_postgres

# Seguridad / 安全
JWT_SECRETO=una_clave_larga_aleatoria_y_secreta
JWT_ALGORITMO=HS256
JWT_MINUTOS_EXPIRACION=60

# Cifrado AES-256 para datos sensibles (RNF-12) / AES-256 敏感数据加密
# Genera una clave con: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
CLAVE_AES256=
